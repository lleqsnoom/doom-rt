diff --git a/Source/VulkanDevice_Init.cpp b/Source/VulkanDevice_Init.cpp
index d01a449..6a412ad 100644
--- a/Source/VulkanDevice_Init.cpp
+++ b/Source/VulkanDevice_Init.cpp
@@ -851,6 +851,73 @@ void RTGL1::VulkanDevice::CreateDevice()
         .features = features,
     };
 
+    // Only request features the physical device actually supports. Vulkan implementations such as
+    // MoltenVK reject vkCreateDevice outright if any requested feature is unavailable, so masking
+    // against the reported capabilities is required for portability.
+    {
+        VkPhysicalDeviceRobustness2FeaturesEXT supRobustness = {
+            .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ROBUSTNESS_2_FEATURES_EXT,
+        };
+        VkPhysicalDeviceVulkan12Features supVulkan12 = {
+            .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES,
+            .pNext = &supRobustness,
+        };
+        VkPhysicalDeviceMultiviewFeatures supMultiview = {
+            .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MULTIVIEW_FEATURES,
+            .pNext = &supVulkan12,
+        };
+        VkPhysicalDevice16BitStorageFeatures supStorage16 = {
+            .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_16BIT_STORAGE_FEATURES,
+            .pNext = &supMultiview,
+        };
+        VkPhysicalDeviceSynchronization2FeaturesKHR supSync2 = {
+            .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SYNCHRONIZATION_2_FEATURES_KHR,
+            .pNext = &supStorage16,
+        };
+        VkPhysicalDeviceRayTracingPipelineFeaturesKHR supRtPipeline = {
+            .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_RAY_TRACING_PIPELINE_FEATURES_KHR,
+            .pNext = &supSync2,
+        };
+        VkPhysicalDeviceAccelerationStructureFeaturesKHR supAs = {
+            .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ACCELERATION_STRUCTURE_FEATURES_KHR,
+            .pNext = &supRtPipeline,
+        };
+        VkPhysicalDeviceFeatures2 supFeatures2 = {
+            .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2,
+            .pNext = &supAs,
+        };
+        vkGetPhysicalDeviceFeatures2( physDevice->Get(), &supFeatures2 );
+
+        {
+            VkBool32*       requested = reinterpret_cast< VkBool32* >( &features );
+            const VkBool32* supported =
+                reinterpret_cast< const VkBool32* >( &supFeatures2.features );
+            constexpr size_t count = sizeof( VkPhysicalDeviceFeatures ) / sizeof( VkBool32 );
+            for( size_t i = 0; i < count; i++ )
+            {
+                requested[ i ] = ( requested[ i ] && supported[ i ] ) ? VK_TRUE : VK_FALSE;
+            }
+        }
+
+        robustness.nullDescriptor &= supRobustness.nullDescriptor;
+        vulkan12Features.samplerMirrorClampToEdge &= supVulkan12.samplerMirrorClampToEdge;
+        vulkan12Features.drawIndirectCount &= supVulkan12.drawIndirectCount;
+        vulkan12Features.shaderFloat16 &= supVulkan12.shaderFloat16;
+        vulkan12Features.shaderSampledImageArrayNonUniformIndexing &=
+            supVulkan12.shaderSampledImageArrayNonUniformIndexing;
+        vulkan12Features.shaderStorageBufferArrayNonUniformIndexing &=
+            supVulkan12.shaderStorageBufferArrayNonUniformIndexing;
+        vulkan12Features.runtimeDescriptorArray &= supVulkan12.runtimeDescriptorArray;
+        vulkan12Features.bufferDeviceAddress &= supVulkan12.bufferDeviceAddress;
+        multiviewFeatures.multiview &= supMultiview.multiview;
+        storage16.storageBuffer16BitAccess &= supStorage16.storageBuffer16BitAccess;
+        sync2Features.synchronization2 &= supSync2.synchronization2;
+        rtPipelineFeatures.rayTracingPipeline &= supRtPipeline.rayTracingPipeline;
+        asFeatures.accelerationStructure &= supAs.accelerationStructure;
+
+        physicalDeviceFeatures2.features = features;
+    }
+
 
     std::vector< VkExtensionProperties > supportedDeviceExtensions;
     {
