+    {
+      unsigned char c = (unsigned char)toupper((unsigned char)fpsstr[i]);
+      w += (c == ' ' || c < HU_FONTSTART || c > 127) ? 4 : hu_font[c - HU_FONTSTART].width;
+    }
+
+    w_fps.x = 320 - w - 2;
+    w_fps.y = HU_COORDXYZ_Y;
