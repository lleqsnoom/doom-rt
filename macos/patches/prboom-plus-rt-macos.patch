+
+  // FPS counter, top-right corner
+  {
+    static unsigned int fps_prev_tick = 0;
+    static unsigned int fps_frames = 0;
+    static int fps_value = 0;
+    char fpsstr[16];
+    int  i, w = 0;
+    unsigned int fps_now = SDL_GetTicks();
+
+    fps_frames++;
+    if (fps_now - fps_prev_tick >= 1000u)
+    {
+      fps_value = (int)(fps_frames * 1000u / (fps_now - fps_prev_tick));
+      fps_frames = 0;
